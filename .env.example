# Copy to .env when configuring a robot or OpenRouter. The dashboard also starts without this file.
# Docker Compose 2.30+ reads values literally: enter key=value without quotes or export.
# Save as UTF-8. Do not share this file after entering passwords or API keys.
X2_SSH_HOST=10.0.1.41
X2_SSH_USER=agi
# Docker: enter the robot password here. See docs/USER_GUIDE_KO.md for private keys.
X2_SSH_PASSWORD=
# The following key/known_hosts paths apply to Python script execution.
# Docker uses compose.ssh-key.yaml for a key, and stores trusted hosts in its data volume.
# X2_SSH_KEY=~/.ssh/id_ed25519
X2_SSH_KNOWN_HOSTS=~/.ssh/known_hosts
# Optional if the robot SDK is installed outside /home/agi/aimdk:
# X2_REMOTE_HOME=/home/agi
# X2_REMOTE_SDK=/home/agi/aimdk
# Docker publishes the dashboard at http://127.0.0.1:8766 (set by compose.yaml).
X2_PORT=8766
OPENROUTER_API_KEY=
VLM_MODEL=qwen/qwen3-vl-30b-a3b-instruct
