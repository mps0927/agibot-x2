# 이 파일을 .env로 복사한 뒤 로봇 비밀번호를 입력하세요.
# 처음 설정: docs/FIRST_START_KO.md
# 값은 따옴표 없이 입력하고 UTF-8로 저장합니다. 이 파일에 실제 키를 적어 Git에 올리지 마세요.

# 1. 로봇 로그인: 기본 주소·계정을 확인하고 담당자가 알려 준 로봇 비밀번호를 입력합니다.
X2_SSH_HOST=10.0.1.41
X2_SSH_USER=agi
X2_SSH_PASSWORD=

# 2. VLM을 사용할 때 입력합니다. 수동 조종만 사용할 때는 비워 둡니다.
OPENROUTER_API_KEY=
VLM_MODEL=qwen/qwen3-vl-30b-a3b-instruct

# Docker 실행: docker compose up -d
# 실행 중 값을 바꿨다면 조종을 끝내고: docker compose up -d --force-recreate
# 대시보드 주소: http://127.0.0.1:8766

# 아래는 설치 위치가 다르거나 Python으로 직접 실행할 때 사용하는 선택 설정입니다.
# X2_REMOTE_HOME=/home/agi
# X2_REMOTE_SDK=/home/agi/aimdk
# X2_PORT=8766
# X2_SSH_KEY=~/.ssh/id_ed25519
# X2_SSH_KNOWN_HOSTS=~/.ssh/known_hosts
# Docker의 개인 키 접속은 docs/USER_GUIDE_KO.md의 '개인 키로 접속하는 경우'를 따릅니다.
